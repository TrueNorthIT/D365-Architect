<Project>
  <!--
    A standalone, single-file build that needs nothing else installed on the
    target machine (no separate .NET runtime, no loose DLLs sitting next to
    it): everything is bundled into one d365architect.exe.

    Only takes effect when explicitly requested via:
      dotnet publish "D365 Architect/D365 Architect.csproj" -p:PublishProfile=win-x64 -c Release
    Ordinary "dotnet build"/"dotnet run" never see these settings, so the
    normal dev inner loop stays framework-dependent and fast.
  -->
  <PropertyGroup>
    <!-- Visual Studio's own Publish page only lists a .pubxml as a
         selectable "Folder" profile once it has these; MSBuild itself
         (and "dotnet publish -p:PublishProfile=win-x64" on the command
         line) ignores them entirely, so their absence doesn't stop the CLI
         from working, only VS's picker from seeing this file. -->
    <PublishProtocol>FileSystem</PublishProtocol>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <TargetFramework>net10.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <PublishDir>bin\$(Configuration)\$(TargetFramework)\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
